---
import { Image } from "astro:assets";
import corelytics from "../assets/project-corelytics.webp";
import neonbyte from "../assets/project-neonbyte.webp";
import zephyr from "../assets/project-zephyr.webp";
import orbit from "../assets/project-orbit.webp";

const PROJECTS = [
  { title: "Rethinking Corelytics", img: corelytics, alt: "Dark architectural metal rooftop at night" },
  { title: "Neonbyte", img: neonbyte, alt: "MacBook beside a mouse on a wooden desk" },
  { title: "Zephyr Media", img: zephyr, alt: "Hand touching a smartwatch in cool blue tones" },
  { title: "Orbit Apps", img: orbit, alt: "Hand holding a black quadcopter drone" },
];
---

<section id="works" class="bg-ink py-28 md:py-36 px-6 md:px-12">
  <div class="mx-auto max-w-[1600px]">
    {/* header row */}
    <div class="flex items-center justify-between mb-12 md:mb-16" data-reveal>
      <div class="label-mono">
        <span class="text-accent mr-2">■</span>Featured Projects
      </div>
      <a
        href="#works"
        class="font-mono text-[12px] uppercase tracking-[0.1em] text-bone hover:text-white transition-colors"
      >
        <span class="roll">
          <span class="roll-inner">
            <span>See more works →</span>
            <span aria-hidden="true">See more works →</span>
          </span>
        </span>
      </a>
    </div>

    {/* 2×2 grid */}
    <div class="grid sm:grid-cols-2 gap-6 md:gap-8">
      {PROJECTS.map((p) => (
        <a href="#works" class="group relative block overflow-hidden rounded-2xl" data-reveal>
          <div class="overflow-hidden" data-parallax>
            <Image
              src={p.img}
              alt={p.alt}
              class="w-full aspect-[4/3] object-cover scale-110"
              data-zoom
            />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-80" />
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8 flex items-end justify-between">
            <span class="font-mono text-[13px] uppercase tracking-[0.12em] text-white">
              {p.title}
            </span>
            <span class="font-mono text-[13px] text-white/70 group-hover:translate-x-1 transition-transform" aria-hidden="true">
              →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
