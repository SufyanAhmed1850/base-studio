---
const SERVICES = [
  {
    num: "01",
    title: "UI Design",
    copy: "Interfaces engineered for clarity — design systems, product screens, and prototypes built to convert and delight.",
  },
  {
    num: "02",
    title: "Branding",
    copy: "Identities with gravity — logos, guidelines, and visual languages that make brands impossible to ignore.",
  },
  {
    num: "03",
    title: "Creative Strategy",
    copy: "Positioning before pixels — research-driven direction that aligns every creative decision with business goals.",
  },
  {
    num: "04",
    title: "Marketing",
    copy: "Design-driven campaigns — pitch decks, motion, and launch assets that make marketing feel like an event.",
  },
];
---

<section id="services" class="bg-ink py-28 md:py-36 px-6 md:px-12">
  <div class="mx-auto max-w-[1600px]">
    <div class="label-mono mb-14 md:mb-20" data-reveal>
      <span class="text-accent mr-2">■</span>Services
    </div>

    {/* four columns, cascading vertical offsets */}
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-0">
      {SERVICES.map((s, i) => (
        <div
          class={`lg:border-l lg:border-white/15 first:border-l-0 lg:px-8 first:pl-0 last:pr-0 ${
            ["lg:pt-0", "lg:pt-16", "lg:pt-32", "lg:pt-48"][i]
          }`}
          data-reveal
          data-reveal-delay={i * 0.08}
        >
          <div class="font-mono text-[12px] uppercase tracking-[0.12em] text-accent">
            ({s.num})
          </div>
          <h4 class="font-display font-bold tracking-tightest text-[1.75rem] md:text-[2rem] mt-4">
            {s.title}
          </h4>
          <p class="font-mono text-[12px] uppercase tracking-[0.08em] leading-[1.9] text-bone/80 mt-6">
            {s.copy}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
