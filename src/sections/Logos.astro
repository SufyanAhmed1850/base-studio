---
import { Marquee } from "../components/Misc";

const CELLS = [
  "Base Studio",
  "VECTOR.SAGE™",
  "INTERGALACTICA",
  "Framebloc",
  "ONTORIA",
  "AMBI DEXTER",
  "Caster.Den",
  "logoipsum",
];
---

<section class="bg-ink py-24 md:py-32">
  {/* infinite marquee strip */}
  <Marquee client:visible />

  {/* static 2×4 grid of dark cells */}
  <div class="mx-auto max-w-[1600px] px-6 md:px-12 mt-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-5">
      {CELLS.map((name) => (
        <div
          class="bg-cell rounded-xl aspect-[16/9] flex items-center justify-center px-6 hover:bg-[#222] transition-colors"
          data-reveal
        >
          <span class="font-mono text-sm md:text-base uppercase tracking-[0.1em] text-white/90 text-center">
            {name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
